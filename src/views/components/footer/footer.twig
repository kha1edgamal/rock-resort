{% set rr_about = theme.settings.get('rr_footer_about') %}
{% set rr_address = theme.settings.get('rr_footer_address') %}
{% set rr_license = theme.settings.get('rr_footer_license') %}
<footer data-testid="store-footer" class="store-footer rr-footer">
  <div class="rr-footer__mountains" aria-hidden="true"></div>
  <div aria-label="footer" class="rr-footer__inner">
    <div class="container rr-footer__grid">

      {# Brand #}
      <div class="rr-footer__brand">
        <a href="{{ link('/') }}" class="rr-footer__logo" aria-label="{{ store.name }}">
          <img src="{{ 'images/rr/logo-light.png' | asset }}" alt="{{ store.name }}" width="132" height="103" loading="lazy">
        </a>
        {% if rr_about %}
          <p class="rr-footer__about">{{ rr_about }}</p>
        {% elseif store.description %}
          <div class="rr-footer__about">{{ store.description|raw }}</div>
        {% endif %}
        {% if rr_license %}
          <p class="rr-footer__license"><i class="sicon-shield-check"></i> {{ rr_license }}</p>
        {% endif %}
        {% if store.settings.tax.number %}
          <p class="rr-footer__tax">{{ trans('common.elements.tax_number') }}: <b>{{ store.settings.tax.number }}</b></p>
        {% endif %}
      </div>

      {# Quick links #}
      <div class="rr-footer__col">
        <h3 class="rr-footer__title">{{ trans('blocks.footer.pages_links') }}</h3>
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
      </div>

      {# Contact #}
      <div class="rr-footer__col rr-footer__contact">
        <h3 class="rr-footer__title">تواصل معنا</h3>
        <ul>
          {% if store.contacts.mobile %}
            <li><i class="sicon-phone"></i><a href="tel:{{ store.contacts.mobile }}" dir="ltr">{{ store.contacts.mobile }}</a></li>
          {% endif %}
          {% if store.contacts.email %}
            <li><i class="sicon-mail"></i><a href="mailto:{{ store.contacts.email }}">{{ store.contacts.email }}</a></li>
          {% endif %}
          {% if rr_address %}
            <li><i class="sicon-location"></i><span>{{ rr_address }}</span></li>
          {% endif %}
        </ul>
      </div>

      {# Social #}
      <div class="rr-footer__col">
        <h3 class="rr-footer__title">تابعنا</h3>
        <salla-social data-testid="store-footer-social" class="rr-footer__social"></salla-social>
        <salla-trust-badges data-testid="store-footer-trust-badges" dark></salla-trust-badges>
      </div>

    </div>
  </div>

  <div class="rr-footer__bottom">
    <div class="container rr-footer__bottom-inner">
      <span class="copyright-text">{% hook copyright %}</span>
      <salla-payments data-testid="store-footer-payments"></salla-payments>
    </div>
  </div>
</footer>
